<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Aestra"
           Manufacturer="Suvro Bhowmick"
           Version="1.1.1"
           UpgradeCode="C8B7A124-4B29-4F58-8C61-5B26E50D6B19"
           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Aestra is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AestraIcon" SourceFile="assets\aestra.ico" />
    <Property Id="ARPPRODUCTICON" Value="AestraIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Elitsuv/aestra" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Aestra">
        <Component Id="MainExecutable" Guid="D1A562B3-7890-4DEF-8C21-123456789ABC">
          <File Id="AestraBat" Source="aestra.bat" KeyPath="yes" />
          <Environment Id="PATH"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="no" />
        </Component>

        <Component Id="PyprojectToml" Guid="A2B3C4D5-1234-5678-9ABC-DEF012345678">
          <File Id="PyprojectFile" Source="pyproject.toml" KeyPath="yes" />
        </Component>

        <Component Id="LicenseFile" Guid="B3C4D5E6-2345-6789-0ABC-DEF012345679">
          <File Id="LicFile" Source="LICENSE" KeyPath="yes" />
        </Component>

        <Directory Id="AssetsFolder" Name="assets">
          <Component Id="AssetsComponent" Guid="E2F3A4B5-3456-7890-1ABC-DEF012345680">
            <File Id="AestraIco" Source="assets\aestra.ico" KeyPath="yes" />
            <File Id="AestraPng" Source="assets\aestra.png" />
          </Component>
        </Directory>

        <Directory Id="SrcFolder" Name="src">
          <Component Id="SrcInit" Guid="F3A4B5C6-4567-8901-2ABC-DEF012345681">
            <File Id="InitPy" Source="src\__init__.py" KeyPath="yes" />
            <File Id="CheckerPy" Source="src\checker.py" />
            <File Id="CliPy" Source="src\cli.py" />
            <File Id="CompilerPy" Source="src\compiler.py" />
            <File Id="ConfigPy" Source="src\config.py" />
            <File Id="EnginePy" Source="src\engine.py" />
            <File Id="ModelsPy" Source="src\models.py" />
            <File Id="RunnerPy" Source="src\runner.py" />
            <File Id="SdkPy" Source="src\sdk.py" />
          </Component>

          <Directory Id="SrcCoreFolder" Name="core">
            <Component Id="SrcCoreFiles" Guid="C4D5E6F7-5678-9012-3ABC-DEF012345682">
              <File Id="CoreLibRs" Source="src\core\lib.rs" KeyPath="yes" />
              <File Id="CorePosixRs" Source="src\core\sandbox_posix.rs" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="D5E6F7A8-6789-0123-4ABC-DEF012345683">
        <Shortcut Id="DesktopShortcut"
                  Name="Aestra"
                  Description="Aestra - Deterministic CP Execution Sandbox"
                  Target="[INSTALLFOLDER]aestra.bat"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AestraIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Aestra"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Aestra Core" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="PyprojectToml" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="AssetsComponent" />
      <ComponentRef Id="SrcInit" />
      <ComponentRef Id="SrcCoreFiles" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>

